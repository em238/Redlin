// Redline Shipping Company - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  role        String    @default("admin")
  roleId      String?
  roleRef     Role?     @relation(fields: [roleId], references: [id])
  status      String    @default("active") // active | inactive | suspended
  avatar      String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Role {
  id            String   @id @default(cuid())
  name          String   @unique
  nameAr        String   @default("")
  description   String   @default("")
  descriptionAr String   @default("")
  descriptionEn String   @default("")
  isSystemRole  Boolean  @default(false)
  permissions   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model Governorate {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAr    String
  zone      String   @default("A")
  basePrice Float    @default(30)
  etaHours  Int      @default(48)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Service {
  id             String  @id @default(cuid())
  name           String  @unique
  nameAr         String
  description    String  @default("")
  descriptionAr  String  @default("")
  descriptionEn  String  @default("")
  ctaTextAr      String  @default("اطلب الخدمة")
  ctaTextEn      String  @default("Request Service")
  icon           String  @default("truck")
  multiplier     Float   @default(1.0)
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  city      String?
  governorate String?
  createdAt DateTime @default(now())
  shipments Shipment[]
}

model Shipment {
  id            String   @id @default(cuid())
  trackingNo    String   @unique
  senderName    String
  senderPhone   String
  senderAddress String
  receiverName  String
  receiverPhone String
  receiverAddress String
  governorate   String
  service       String
  weight        Float
  notes         String?
  price         Float
  status        String   @default("pending")
  history       String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customerId    String?
  customer     Customer? @relation(fields: [customerId], references: [id])
}

model Video {
  id             String   @id @default(cuid())
  title          String
  titleAr        String   @default("")
  description    String?
  descriptionAr  String   @default("")
  url            String
  thumbnail      String?
  category       String   @default("promo")
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  nameAr    String   @default("")
  role      String
  roleAr    String   @default("")
  company   String?
  companyAr String?
  content   String
  contentAr String   @default("")
  rating    Int      @default(5)
  avatar    String?
  active    Boolean  @default(true)
  status    String   @default("approved")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  customerName String
  phone       String
  governorate String
  service     String
  weight      Float
  price       Float
  status      String   @default("pending")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteStat {
  id        String   @id @default(cuid())
  label     String
  labelAr   String   @default("")
  value     String
  icon      String   @default("package")
  createdAt DateTime @default(now())
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  title     String?
  titleAr   String   @default("")
  titleEn   String   @default("")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model HeroContent {
  id              String   @id @default(cuid())
  badgeAr         String   @default("نشحن لكل محافظات مصر — 27 محافظة بنفس السرعة")
  badgeEn         String   @default("We Ship Across All Egypt — 27 Governorates with Equal Speed")
  titleAr         String   @default("شحن يصل لكل مصر بسرعة Redline")
  titleEn         String   @default("Shipping Across Egypt at Redline Speed")
  subtitleAr      String   @default("")
  subtitleEn      String   @default("")
  cta1TextAr      String   @default("اطلب شحن الآن")
  cta1TextEn      String   @default("Order Shipment Now")
  cta1Link        String   @default("#contact")
  cta2TextAr      String   @default("خدماتنا")
  cta2TextEn      String   @default("Our Services")
  cta2Link        String   @default("#services")
  feature1Ar      String   @default("توصيل نفس اليوم في القاهرة الكبرى")
  feature1En      String   @default("Same-day delivery in Greater Cairo")
  feature2Ar      String   @default("ضمان كامل على كل شحنة")
  feature2En      String   @default("Full guarantee on every shipment")
  feature3Ar      String   @default("27 محافظة بتغطية كاملة")
  feature3En      String   @default("Full coverage across 27 governorates")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  nameAr    String   @default("")
  logo      String?
  icon      String   @default("building")
  color     String   @default("#dc2626")
  website   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// === New models for dedicated content management ===

model About {
  id            String   @id @default(cuid())
  titleAr       String   @default("من نحن")
  titleEn       String   @default("About Us")
  subtitleAr    String   @default("")
  subtitleEn    String   @default("")
  descriptionAr String   @default("")
  descriptionEn String   @default("")
  image         String?
  features      String   @default("") // JSON array of {ar, en}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HowItWorksStep {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  titleAr     String
  titleEn     String
  descAr      String
  descEn      String
  icon        String   @default("clipboard-list")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactInfo {
  id        String   @id @default(cuid())
  type      String   // "address" | "phone" | "email"
  labelAr   String
  labelEn   String
  value     String
  href      String?  // tel: or mailto: link
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WhatsAppSetting {
  id              String   @id @default(cuid())
  phoneNumber     String   @default("201000000000")
  defaultMessageAr String  @default("مرحباً، أريد الاستفسار عن خدمات الشحن")
  defaultMessageEn String  @default("Hello, I'd like to inquire about shipping services")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
